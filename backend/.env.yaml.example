# Cloud Run Environment Variables (.env.yaml)
# Copy to .env.yaml and fill in actual secrets for Cloud Run deployment
# Reference: https://cloud.google.com/run/docs/quickstarts/build-and-deploy
# CRITICAL: Read DEPLOYMENT.md "Database Migrations & Cloud SQL Connection" section first!
# Also see: GOOGLE_OAUTH_SETUP.md for authentication configuration

# ============================================================================
# GOOGLE OAUTH (REQUIRED FOR LOGIN)
# ============================================================================
# How to reuse OAuth credentials across multiple projects:
# 1. Use the SAME Google Client ID for all your projects (start with Pantry Queen)
# 2. Just add your new frontend URL to authorized origins in Google Cloud Console
# 3. See GOOGLE_OAUTH_SETUP.md for detailed instructions
GOOGLE_CLIENT_ID: your-google-client-id

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# ⚠️  IMPORTANT: Use INSTANCE_CONNECTION_NAME (Unix socket), NOT DB_HOST/DB_PORT
# To get INSTANCE_CONNECTION_NAME, run:
#   gcloud sql instances describe YOUR_INSTANCE --format='value(connectionName)'
DB_USER: postgres
DB_PASSWORD: your_password_here_from_cloud_sql
INSTANCE_CONNECTION_NAME: your-project:us-central1:your-instance
DB_NAME: startingplace

# DO NOT SET DB_HOST or DB_PORT - they break Cloud SQL connections!
# Use TCP connection only for LOCAL development

# ============================================================================
# JWT SECRETS
# ============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET: your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET: your-refresh-secret-key-change-this-in-production-min-32-chars

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV: production
FRONTEND_URL: https://your-domain.com

# ============================================================================
# OPTIONAL: API KEYS
# ============================================================================
# ANTHROPIC_API_KEY: sk-ant-api03-...
# STRIPE_SECRET_KEY: sk_live_...
# STRIPE_PUBLISHABLE_KEY: pk_live_...
