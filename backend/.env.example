# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=startingplace

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production-min-32-chars

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Stripe Configuration (Optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# GCP Configuration
GCP_PROJECT_ID=your-project-id
INSTANCE_CONNECTION_NAME=your-project:us-central1:your-instance

# Environment
NODE_ENV=development

# Server Configuration
PORT=5001
FRONTEND_URL=http://localhost:3000

# ============================================================================
# LOGIN MODE - Choose how users authenticate
# ============================================================================
# 'google'  - Only Google OAuth (production recommended if GOOGLE_CLIENT_ID set)
# 'email'   - Only email/password authentication
# 'test'    - Only test login with hardcoded demo users (DEVELOPMENT ONLY)
# 'both'    - Google OAuth + email/password + test login (good for dev/staging)
#
# If you hit 404 errors on /api/auth/google-signin in Cloud Run:
# 1. Set LOGIN_MODE=both or LOGIN_MODE=test to verify backend is running
# 2. Check FRONTEND_URL matches your actual frontend domain
# 3. Check GOOGLE_CLIENT_ID is set in Cloud Run secrets
#
LOGIN_MODE=google

# ============================================================================
# SIGNUP MODE
# ============================================================================
# By default every non-seed signup lands in pending_approval and waits for a
# platform super-admin at /admin/access-requests. Set OPEN_SIGNUP=true to let
# anyone sign up and start using their own workspace immediately (instant
# self-serve). Seed admins (SEED_ADMIN_EMAILS) are always active.
# OPEN_SIGNUP=true
